<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><OutputType>WinExe</OutputType>
    <LangVersion>5</LangVersion><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Assets/Nook.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/*.cs" />
    <EmbeddedResource Include="Assets/Theme.xaml" LogicalName="Nook.Theme.xaml" />
    <Reference Include="PresentationFramework"/><Reference Include="PresentationCore"/><Reference Include="WindowsBase"/>
    <Reference Include="System.Xaml"/><Reference Include="System.Windows.Forms"/><Reference Include="System.Drawing"/><Reference Include="System.Runtime.Serialization"/>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all"/>
  </ItemGroup>
</Project>
