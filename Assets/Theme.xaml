 <Style TargetType="Slider">
  <Setter Property="Height" Value="28"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="IsMoveToPointEnabled" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid Margin="6,0" Background="Transparent">
    <Border Height="4" CornerRadius="2" Background="{DynamicResource Color3A5144}" VerticalAlignment="Center"/>
    <Track x:Name="PART_Track">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource QuietRepeat}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource QuietRepeat}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Grid Background="Transparent">
       <Ellipse x:Name="focusRing" Margin="-4" Stroke="{DynamicResource ColorA8F3D0}" StrokeThickness="1" Opacity="0" IsHitTestVisible="False"/>
       <Ellipse Fill="{DynamicResource ColorA8F3D0}" Stroke="{DynamicResource ColorD8FFE9}" StrokeThickness="1"/>
      </Grid>
      <ControlTemplate.Triggers>
       <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True"><Setter TargetName="focusRing" Property="Opacity" Value=".8"/></DataTrigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="focusRing" Property="Opacity" Value=".45"/></Trigger>
       <Trigger Property="IsDragging" Value="True"><Setter TargetName="focusRing" Property="Opacity" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    </Track>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
